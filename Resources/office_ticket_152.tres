multi_files = {"models.py": "from django.db import models\n\nclass Classroom(models.Model):\n    name = models.CharField(max_length=120)\n\nclass Student(models.Model):\n    full_name = models.CharField(max_length=160)\n\nclass StudentProfile(models.Model):\n    student = models.OneToOneField(Student, related_name=\"profile\", on_delete=models.CASCADE)\n    classroom = models.ForeignKey(Classroom, related_name=\"student_profiles\", on_delete=models.CASCADE)\n", "serializers.py": "from rest_framework import serializers\nfrom .models import Student\n\nclass StudentRosterSerializer(serializers.ModelSerializer):\n    classroom_name = serializers.CharField(source=\"profile.classroom.name\", read_only=True)\n\n    class Meta:\n        model = Student\n        fields = [\"id\", \"full_name\", \"classroom_name\"]\n", "views.py": "# Build the classroom roster API endpoint here.\n# Reference files: models.py and serializers.py.\n\n@api_view([\"GET\"])\ndef classroom_roster(request, classroom_id):\n    classroom = Classroom.objects.get(id=classroom_id)\n    students = Student.objects.filter(classroom=classroom)\n    serializer = StudentRosterSerializer(students, many=True)\n    return Response(serializer.data)"}
multi_expected_answers = {"views.py": PackedStringArray("from rest_framework.decorators import api_view\nfrom rest_framework.response import Response\nfrom .models import Classroom, Student\nfrom .serializers import StudentRosterSerializer\n\n@api_view([\"GET\"])\ndef classroom_roster(request, classroom_id):\n    classroom = Classroom.objects.get(id=classroom_id)\n    students = Student.objects.filter(profile__classroom=classroom)\n    serializer = StudentRosterSerializer(students, many=True)\n    return Response(serializer.data)", "from rest_framework.decorators import api_view\nfrom rest_framework.response import Response\nfrom .models import Classroom, Student\nfrom .serializers import StudentRosterSerializer\n\n@api_view([\"GET\"])\ndef classroom_roster(request, classroom_id):\n    classroom = Classroom.objects.get(id=classroom_id)\n    queryset = Student.objects.filter(profile__classroom=classroom)\n    serializer = StudentRosterSerializer(queryset, many=True)\n    return Response(serializer.data)")}
