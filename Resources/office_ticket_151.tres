interactive_steps = Array[Dictionary]([{"id":"inspect","title":"Inspect the failing lookup","description":"Review the open views.py file and find the direct classroom lookup that returns no records.","trigger":"file_opened","validator_value":"views.py","hint":"The classroom field belongs to StudentProfile, not Student."},{"id":"query","title":"Use the reverse relationship","description":"In views.py, filter Student through profile__classroom.","trigger":"code_contains","validator_value":"profile__classroom\\s*=\\s*classroom","validator_file":"views.py","hint":"Django follows a related model field with double underscores."},{"id":"verify","title":"Run the queryset check","description":"Run the check and confirm that 24 classroom records serialize.","trigger":"run_executed","validator_value":"success","hint":"A successful run reports HTTP 200 and 24 records."}])
