script = ExtResource("1_ticket")
labels = PackedStringArray("bug", "frontend", "css", "high-priority")
description = "The Student Learning Portal dashboard cards overflow the viewport on narrow mobile screens. The desktop layout is fine; please make a targeted responsive fix without rewriting unrelated navigation styles."
