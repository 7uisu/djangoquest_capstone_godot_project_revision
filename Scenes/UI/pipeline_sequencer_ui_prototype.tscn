rule_entries = [{"id":"ARCH-01","title":"Route before handling view logic","badge":"ARCHITECTURE","description":"Django resolves a URL pattern before running the matching view. The view then uses models to work with data.","bad_code":"views.py handles the request before urls.py routes it","good_code":"urls.py routes to views.py, which uses models.py"}]
