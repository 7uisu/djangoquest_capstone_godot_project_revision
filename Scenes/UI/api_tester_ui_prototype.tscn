start_opened = false
manual_title = "API Security Reference"
rule_entries = [{"id":"SEC-04","title":"A valid token does not grant access to every record","badge":"SECURITY","description":"The endpoint must verify that the authenticated user is allowed to access the student ID in the URL.","bad_code":"Student.objects.get(id=student_id)","good_code":"Student.objects.get(id=student_id, user=request.user)"}]
