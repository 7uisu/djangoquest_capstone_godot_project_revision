speaker_name = "Reynalda Patalinghug"
dialogue_line_1 = "I'm Reynalda, DevOps. Deployment, environment config, migrations — things only break in production when someone skips my checklist."
second_visit_dialogue = "A release needs an owner, a rollback plan, and a checklist that includes migrations."
reminder_dialogue = "Before deployment, verify the environment, migrations, and recovery plan."
optional_choice_prompt = "Want to hear the release check I never skip?"
optional_choice_a = "Which one?"
optional_choice_b = "I already have a release list."
optional_choice_reply_a = "Check the migration state in the target environment and make sure the rollback owner is clear."
optional_choice_reply_b = "Excellent. Make sure it names the environment, migration status, and rollback owner."

