speaker_name = "Mario Ellan Cruz"
dialogue_line_1 = "Hi! I'm Mario, the client representative. We're counting on the team to build the Student Learning Portal right."
second_visit_dialogue = "When a request is unclear, ask how it affects the students and teachers using the portal."
reminder_dialogue = "Keep the users in mind, and make sure we understand the request before building it."
optional_choice_prompt = "Want to hear what the school clients care about most?"
optional_choice_a = "What matters most to them?"
optional_choice_b = "I can ask them directly."
optional_choice_reply_a = "They need teachers to understand student progress quickly, without exposing information to the wrong person."
optional_choice_reply_b = "Exactly. Ask the people who will use the portal, then confirm the problem they need solved."

