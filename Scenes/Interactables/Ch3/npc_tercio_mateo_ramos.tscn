speaker_name = "Tercio Mateo Ramos"
interaction_text = "(F) to Talk"
dialogue_line_1 = "Organizing hardware backups and server cables. Clean infrastructure prevents random downtime!"
second_visit_dialogue = "Credentials should stay out of source control, even when a repository is private."
reminder_dialogue = "Rotate exposed secrets and keep replacements in secure environment configuration."
optional_choice_prompt = "Want a quick reminder about leaked credentials?"
optional_choice_a = "Yes, tell me."
optional_choice_b = "I know not to commit them."
optional_choice_reply_a = "Remove the secret from the repository, rotate it, and store the replacement outside source control."
optional_choice_reply_b = "Right—and if one leaks, removing the line isn't enough. Rotate the credential too."

