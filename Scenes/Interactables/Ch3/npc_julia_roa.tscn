speaker_name = "Julia Roa"
dialogue_line_1 = "I'm Julia Roa, Executive Sponsor of the Student Learning Portal. I'll be evaluating your final presentation. Make it count."
second_visit_dialogue = "Keep the presentation focused on user impact, delivery risks, and evidence that the feature works."
reminder_dialogue = "For the board, connect your technical decisions to student and client outcomes."
optional_choice_prompt = "Would you like a presentation tip from the client side?"
optional_choice_a = "Yes, please."
optional_choice_b = "I'll focus on the demo."
optional_choice_reply_a = "Show the user problem, the outcome, and evidence that the feature works. Keep implementation details tied to that story."
optional_choice_reply_b = "A working demo helps. Add the user impact and a clear account of the risks you handled."

