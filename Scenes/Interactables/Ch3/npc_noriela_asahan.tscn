speaker_name = "Noriela Asahan"
dialogue_line_1 = "Welcome to DJQ Corp! Don't stress too much on your first sprint—take coffee breaks, ask questions, and collaborate."
second_visit_dialogue = "A good team shares context early, especially when a blocker might affect someone else's work."
reminder_dialogue = "Take a breath, ask for help, and keep your teammates in the loop."
optional_choice_prompt = "Need a reminder for those stressful sprint days?"
optional_choice_a = "I do, actually."
optional_choice_b = "I'm doing okay."
optional_choice_reply_a = "Break the problem into one next step, and let the team know early if something is blocked."
optional_choice_reply_b = "That's good. Keep checking in with your teammates as the work changes."

