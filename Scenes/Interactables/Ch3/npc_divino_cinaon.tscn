speaker_name = "Divino Cinaon"
dialogue_line_1 = "I'm Divino, Server and Network Specialist. This area is restricted to authorized personnel. Do you have clearance to be here?"
second_visit_dialogue = "The server room is quiet again, but don't skip the logs when a production issue appears."
reminder_dialogue = "If something breaks in production, start with the logs and verify each recovery step."
optional_choice_prompt = "Would you like a production-triage reminder?"
optional_choice_a = "Yes, please."
optional_choice_b = "I'll remember the logs."
optional_choice_reply_a = "Confirm impact, inspect logs, identify the failing change, then verify the recovery—not only the deployment."
optional_choice_reply_b = "Good. Also tell the team what you find and confirm the service is healthy afterward."

