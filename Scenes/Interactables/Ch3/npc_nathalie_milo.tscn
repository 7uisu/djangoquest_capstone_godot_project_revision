speaker_name = "Nathalie Milo"
dialogue_line_1 = "I'm Nathalie, Data Analyst. If your schema isn't normalized, the reporting will be a mess. Let's talk before you create those models."
second_visit_dialogue = "Think about how the data will be queried and reported before you settle the model structure."
reminder_dialogue = "Plan the relationships carefully; clean data structures make reliable reporting possible."
optional_choice_prompt = "Want a quick data-modeling question to think about?"
optional_choice_a = "Go ahead."
optional_choice_b = "Maybe after this task."
optional_choice_reply_a = "Ask which records need to be reported together, and what relationship makes that query reliable."
optional_choice_reply_b = "All right. When you're ready, start from the reports users actually need."

