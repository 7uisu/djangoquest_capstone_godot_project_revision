speaker_name = "Hanna Luisa Paday"
dialogue_line_1 = "I'm Hanna, System Designer. Before you write a single line of code in this company, you plan the architecture first."
second_visit_dialogue = "Sketch the data relationships and user flow before choosing where each responsibility belongs."
reminder_dialogue = "A quick flowchart or ERD can reveal problems before they become code."
optional_choice_prompt = "Want to hear why I insist on flowcharts before implementation?"
optional_choice_a = "Yes, I'm curious."
optional_choice_b = "Maybe another time."
optional_choice_reply_a = "A clear flow exposes missing states and dependencies before they become expensive rewrites."
optional_choice_reply_b = "No problem. A few minutes planning can still save hours of rework."

