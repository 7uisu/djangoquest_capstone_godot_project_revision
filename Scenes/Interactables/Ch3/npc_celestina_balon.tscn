speaker_name = "Celestina Balon"
dialogue_line_1 = "I'm Celestina, QA Lead. My job is to make sure what we build actually works before it reaches users."
second_visit_dialogue = "A fix is not verified until the original bug is reproduced and tested again."
reminder_dialogue = "Remember to verify the reported problem after the fix—not just assume it works."
optional_choice_prompt = "Would you like to hear my favorite QA rule?"
optional_choice_a = "Tell me."
optional_choice_b = "I think I know it."
